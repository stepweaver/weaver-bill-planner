# Neon Postgres connection string (never use NEXT_PUBLIC_ for this)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# Auth.js secret, e.g. run: openssl rand -base64 32
AUTH_SECRET=

# Comma-separated username:password (passwords must not contain , or :)
AUTHORIZED_USERS=

# Web Push. Generate with: npx web-push generate-vapid-keys
# Keep the private key server-side. Do not prefix either key with NEXT_PUBLIC_.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
