[Unit]
Description=λledger daily bill and payday notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ledger
Group=ledger
WorkingDirectory=/opt/ledger
EnvironmentFile=/etc/ledger/notify.env
ExecStart=/usr/bin/env npm run notify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ledger
