[Unit]
Description=λledger daily bill and payday notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/ledger
EnvironmentFile=/etc/ledger/notify.env
ExecStart=/usr/bin/npm run notify --prefix /opt/ledger
User=ledger
NoNewPrivileges=true
PrivateTmp=true
