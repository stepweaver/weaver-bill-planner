[Unit]
Description=λledger daily bill and payday notifications
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=weaver
WorkingDirectory=/srv/apps/ledger
# Optional overrides. The job also loads .env.local in the app directory.
EnvironmentFile=-/etc/ledger/notify.env
ExecStart=/usr/bin/env npm run notify
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/srv/apps/ledger
